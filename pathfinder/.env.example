# 复制为 .env 后填写；不填也可以用 mock provider 跑通整条管道（pf demo）
# ---- 国内模型（研究主力：中文岗位语义 / 公司团队 / 联网查证）----
MOONSHOT_API_KEY=          # Kimi：platform.moonshot.cn（kimi-k3，自带 $web_search 联网）
ZHIPU_API_KEY=             # 智谱：bigmodel.cn（glm-5.3，自带 web_search 工具 + 独立 Web Search API）
DEEPSEEK_API_KEY=          # DeepSeek：platform.deepseek.com（deepseek-chat，批量分类）
DASHSCOPE_API_KEY=         # 通义（可选）

# ---- Claude（可选：想让它写私信 / 作战卡时，把 models.yaml 的 routing 改成 anthropic）----
ANTHROPIC_API_KEY=

# ---- 研究阶段怎么拿证据 ----
# native ：让研究模型用自己的联网搜索（Kimi $web_search / 智谱 web_search 工具 / Claude web_search），推荐
# zhipu  ：先用智谱 Web Search API 搜，再把结果喂给模型（任何模型都能用）
# bocha | tavily | serper ：其他搜索 API
# none   ：不搜索，导出 packet 让 Claude Code / Kimi 网页版去做
PF_SEARCH_PROVIDER=native
ZHIPU_SEARCH_ENGINE=search_std     # zhipu 模式下：search_std | search_pro | search_pro_sogou | search_pro_quark
BOCHA_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# ---- 强制所有 LLM 调用走 mock（离线演示 / 测试）----
PF_MOCK=0
