# 复制为 .env 后填写；不填也可以用 mock provider 跑通整条管道（pf demo）
# ---- Claude（架构判断 / 研究综合 / 文案）----
ANTHROPIC_API_KEY=

# ---- 国内模型（中文岗位语义 / 国内语境 / 批量分类）----
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=

# ---- 网页搜索（验证 JD / 团队 / 新闻）；不配则走 packet 手动模式 ----
# 可选：tavily | serper | bocha | claude_web | none
PF_SEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPER_API_KEY=
BOCHA_API_KEY=

# ---- 强制所有 LLM 调用走 mock（离线演示 / 测试）----
PF_MOCK=0
